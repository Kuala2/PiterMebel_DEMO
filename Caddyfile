# Одношаговый редирект с HTTP / www на канонический HTTPS URL с trailingSlash
(canonical_domain_redirect) {
    @canonicalRootIndex path /index.html
    handle @canonicalRootIndex {
        redir https://pitermebel.com/ permanent
    }

    @canonicalNestedIndex path_regexp canonicalNestedIdx ^(/.*)/index\.html$
    handle @canonicalNestedIndex {
        redir https://pitermebel.com{re.canonicalNestedIdx.1}/ permanent
    }

    @canonicalNoSlashWithQuery {
        path_regexp ^/[^.]*[^/]$
        expression `{query} != ""`
    }
    handle @canonicalNoSlashWithQuery {
        redir https://pitermebel.com{path}/?{query} permanent
    }

    @canonicalNoSlash {
        path_regexp ^/[^.]*[^/]$
        expression `{query} == ""`
    }
    handle @canonicalNoSlash {
        redir https://pitermebel.com{path}/ permanent
    }

    handle {
        redir https://pitermebel.com{uri} permanent
    }
}

# 1. HTTP (порт 80): отдаем robots.txt и sitemap.xml с кодом 200 БЕЗ редиректа (жесткое требование Яндекса при переезде сайта)
http://pitermebel.com, http://www.pitermebel.com {
    import legacy_redirects

    @seoFiles path /robots.txt /sitemap.xml
    handle @seoFiles {
        root * /var/www/pitermebel/out
        file_server
    }

    # Все остальные страницы редиректим на канонический HTTPS URL за один переход
    handle {
        import canonical_domain_redirect
    }
}

# 2. Редирект с HTTPS www на основной HTTPS домен за один переход
https://www.pitermebel.com {
    import legacy_redirects

    handle {
        import canonical_domain_redirect
    }
}

# 3. Основной сайт HTTPS
https://pitermebel.com {
    encode zstd gzip

    # Корневая директория статического экспорта
    root * /var/www/pitermebel/out

    # Вебвизор и карта кликов отключены; внешний встраиваемый просмотр не требуется.
    header Content-Security-Policy "frame-ancestors 'self';"
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "strict-origin-when-cross-origin"
    header Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # includeSubDomains добавлять только после выпуска и проверки сертификата www.
    header Strict-Transport-Security "max-age=31536000"

    import legacy_redirects

    # Служебные артефакты 404 из Next.js export не должны отдавать 200 OK
    @notFoundPages path /404 /404/ /404.html /404/index.html
    handle @notFoundPages {
        error "Not Found" 404
    }

    # Канонизация прямых запросов к index.html
    @rootIndexHtml path /index.html
    handle @rootIndexHtml {
        redir https://pitermebel.com/ permanent
    }

    @nestedIndexHtml path_regexp nestedIdx ^(/.*)/index\.html$
    handle @nestedIndexHtml {
        redir https://pitermebel.com{re.nestedIdx.1}/ permanent
    }

    # Хешированные ассеты Next.js (_next/static/*)
    @static {
        path /_next/static/*
    }
    header @static Cache-Control "public, max-age=31536000, immutable"
    header @static Access-Control-Allow-Origin "*"

    # Медиа, шрифты и изображения
    @media {
        path *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf *.mp4 *.webm
    }
    header @media Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
    header @media Access-Control-Allow-Origin "*"

    # HTML-страницы и маршруты: валидация свежести
    @html {
        path *.html / /kitchens/* /wardrobes/* /custom-furniture/* /projects/* /production/* /design/* /contacts/* /calculator/* /knowledge/* /apartment/* /privacy/* /consent/*
    }
    header @html Cache-Control "no-cache, must-revalidate"

    # Служебные SEO-заголовки: MIME для RSS и Web App Manifest, noindex для ключей IndexNow и RSC-пейлоадов Next.js, canonical для PDF-чеклиста
    header /feed.xml >Content-Type "application/rss+xml; charset=utf-8"
    header /site.webmanifest >Content-Type "application/manifest+json; charset=utf-8"
    @indexNowKeys path /26da01ce2942637d1211788353ad4152.txt /4cfd1e5053fe673a12445d798d7e27f6.txt
    header @indexNowKeys X-Robots-Tag "noindex, nofollow"
    @rscPayloads path /index.txt */index.txt
    header @rscPayloads X-Robots-Tag "noindex, nofollow"
    header @rscPayloads Cache-Control "no-cache, must-revalidate"
    header /downloads/kitchen-electrics-checklist.pdf Link `<https://pitermebel.com/knowledge/rozetki-na-kuhne-shema-vysoty/>; rel="canonical"`

    # Защита статических файлов от превращения в HTML:
    # Если файл не найден, возвращаем 404, а не главную страницу index.html
    @staticFiles {
        path /_next/* *.css *.js *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf *.mp4 *.webm *.json *.xml *.txt *.webmanifest
    }
    handle @staticFiles {
        file_server
    }

    # Роутинг для HTML-страниц статического экспорта (trailingSlash: true):
    # file_server сам отдаёт <dir>/index.html и редиректит /path -> /path/ (308),
    # без try_files {path}/index.html (который отдавал бы дубли 200 OK без слеша).
    handle {
        file_server
    }

    handle_errors {
        # Сбрасываем долгосрочный Cache-Control (например immutable для /_next/static/*), чтобы 404/5xx не кешировались
        header Cache-Control "no-store"
        header X-Robots-Tag "noindex"

        @errStatic path /_next/* *.css *.js *.jpg *.jpeg *.png *.webp *.avif *.svg *.ico *.woff *.woff2 *.pdf *.mp4 *.webm *.json *.xml *.txt *.webmanifest
        handle @errStatic {
            respond "{err.status_code} {err.status_text}"
        }

        @404 expression `{err.status_code} == 404`
        handle @404 {
            rewrite * /404.html
            file_server
        }
    }
}
