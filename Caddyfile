    @legacyBathroomPur path /projects/bathroom-pur-vanity /projects/bathroom-pur-vanity/ /projects/bathroom-vanity /projects/bathroom-vanity/
    handle @legacyBathroomPur {
        redir https://pitermebel.com/custom-furniture/bathroom/ permanent
    }

    @legacyKitchenProjects path_regexp legacyKitchen ^/projects/(island-parquet|oak-stone|white-showcase|marble-hood|narrow-kitchen|emerald-enamel|velvet-matte|sherman-cognac)/?$
    handle @legacyKitchenProjects {
