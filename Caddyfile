# Конфигурация Caddy для pitermebel.com (Next.js Static Export)

(legacy_redirects) {
    @legacyRootEn path /en /en/*
    handle @legacyRootEn {
        redir https://pitermebel.com/ permanent
    }

    @legacyCatalogKitchen path /catalog/kitchen /catalog/kitchen/
    handle @legacyCatalogKitchen {
        redir https://pitermebel.com/kitchens/ permanent
    }

    @legacySlavena path /kitchens/slavena /kitchens/slavena/
    handle @legacySlavena {
        redir https://pitermebel.com/kitchens/mdf-plastik-gola/ permanent
    }

    @legacyAleksandra path /kitchens/aleksandra /kitchens/aleksandra/
